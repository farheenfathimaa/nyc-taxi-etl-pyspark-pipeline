# ================================================================================
# Copy to `.env` before `docker compose up`:   (Windows)  copy .env.example .env
# Powershell:                          Copy-Item .env.example .env
# ================================================================================

# UID the Airflow containers run with (official recommendation on Windows).
AIRFLOW_UID=50000

# Airflow / stack configuration
AIRFLOW_IMAGE_NAME=nyc-taxi-airflow:2.10.5
AIRFLOW_WEB_SERVER_PORT=8080
AIRFLOW_WEB_SECRET=change-this-to-a-long-random-string-before-any-real-use

# Fernet key for Airflow's secret encryption (generated once, safe to keep local).
FERNET_KEY=LQ-qUZfBHBXzPP-KtPOz-QuUOgdZDtwp_pvlgr_HgLs=

# --------------------------------------------------------------------------------
# Pipeline inputs (read by the DAG on every run; change then `docker compose up -d`)
#   TAXI_DATASET : yellow | green | fhvhv
#   TAXI_MONTHS  : single month "2025-01" or comma-separated "2025-01,2025-02"
# --------------------------------------------------------------------------------
TAXI_DATASET=yellow
TAXI_MONTHS=2025-01

# Spark knobs (consumed by spark/jobs/taxi_etl.py). local[*] = run on the container
# CPU cores; raise driver memory if a JVM OOM shows up in the task logs.
SPARK_DRIVER_MEMORY=2g
SPARK_MASTER_URL=local[*]